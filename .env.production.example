# ========================================================
# Sightline production deployment secrets
# ========================================================
# Add these as GitHub Actions repository/environment secrets for
# .github/workflows/deploy-production.yml.

# SSH connection
PRODUCTION_SSH_HOST=your-server-ip
PRODUCTION_SSH_USERNAME=your-ssh-user
PRODUCTION_SSH_PASSWORD=your-ssh-password
PRODUCTION_SSH_PORT=22

# Public app URLs
PRODUCTION_APP_PORT=3322
PRODUCTION_PUBLIC_URL=https://memofi.tech
PRODUCTION_ALLOWED_HOSTS=memofi.tech,www.memofi.tech,localhost,127.0.0.1,api,web,nginx
PRODUCTION_CORS_ALLOWED_ORIGINS=https://memofi.tech,https://www.memofi.tech
PRODUCTION_CSRF_TRUSTED_ORIGINS=https://memofi.tech,https://www.memofi.tech

# Django
PRODUCTION_SIGHTLINE_SECRET_KEY=replace-with-a-long-random-secret
PRODUCTION_DJANGO_SUPERUSER_USERNAME=admin
PRODUCTION_DJANGO_SUPERUSER_EMAIL=admin@memofi.tech
PRODUCTION_DJANGO_SUPERUSER_PASSWORD=replace-with-a-strong-password

# Database
PRODUCTION_POSTGRES_DB=sightline
PRODUCTION_POSTGRES_USER=sightline
PRODUCTION_POSTGRES_PASSWORD=replace-with-a-strong-database-password

# Optional deployment notifications
PRODUCTION_DISCORD_WEBHOOK_URL=
