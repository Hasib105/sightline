# Root / Django environment example
# Copy this to .env or set variables in your environment

SIGHTLINE_SECRET_KEY=change-me
SIGHTLINE_DEBUG=1
SIGHTLINE_ALLOWED_HOSTS=localhost,127.0.0.1
SIGHTLINE_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SIGHTLINE_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CELERY_BROKER_URL=redis://localhost:6379/0
# Run YOLO in the API process (recommended for live WebSocket preview). Set to 1 to use Celery worker.
SIGHTLINE_ANALYSIS_USE_CELERY=0
SIGHTLINE_ANALYSIS_THREAD_FALLBACK=1
# Redis channel layer for live analysis WebSocket (defaults to CELERY_BROKER_URL db 1 when unset).
# CHANNEL_LAYER_REDIS_URL=redis://localhost:6379/1
# Set to 0 to skip background YOLO warmup on API startup (video analysis still warms on demand).
SIGHTLINE_EXAM_DETECTION_WARMUP=1
# API entrypoint seeds MVP demo data once when the database has no MVP courses.
SIGHTLINE_SEED_IF_EMPTY=1
# Local Qdrant fallback path when QDRANT_URL is unset or unreachable.
# SIGHTLINE_QDRANT_PATH=./qdrant_data
EXAM_AI_ANALYSIS_FPS=2.0
EXAM_AI_MODEL_SIZE=s

# Course chatbot
GROQ_API_KEY=
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
# Leave unset for embedded local Qdrant. Docker Compose configures the Qdrant service.
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# Leave unset for local SQLite. Set this for local PostgreSQL outside Docker.
# DATABASE_URL=postgres://sightline:sightline@localhost:5432/sightline

# Next.js web app
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_AUTH_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_WEB_BASE_URL=http://localhost:3000
API_INTERNAL_BASE_URL=http://127.0.0.1:8000

# Optionally set database URL or other envs as needed
