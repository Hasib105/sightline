# Root / Django environment example
# Copy this to .env or set variables in your environment

SIGHTLINE_SECRET_KEY=change-me
SIGHTLINE_DEBUG=1
SIGHTLINE_ALLOWED_HOSTS=localhost,127.0.0.1
CELERY_BROKER_URL=redis://localhost:6379/0

# Next.js web app
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_AUTH_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_WEB_BASE_URL=http://localhost:3000
API_INTERNAL_BASE_URL=http://127.0.0.1:8000

# Optionally set database URL or other envs as needed
