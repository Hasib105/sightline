{
  "name": "sightline",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "description": "Sightline monorepo for the Django API, Next.js web app, inference worker, docs, and infrastructure.",
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "api:install": "python -m pip install -r apps/api-django/requirements.txt",
    "api:makemigrations": "python apps/api-django/manage.py makemigrations sightline",
    "api:migrate": "python apps/api-django/manage.py migrate",
    "api:seed": "python apps/api-django/manage.py seed_sightline",
    "api:dev": "python apps/api-django/manage.py runserver 127.0.0.1:8000",
    "backend:install": "pnpm run api:install",
    "web:install": "pnpm install --filter sightline-web",
    "web:dev": "pnpm --filter sightline-web dev",
    "web:build": "pnpm --filter sightline-web build",
    "web:lint": "pnpm --filter sightline-web lint",
    "web:preview": "pnpm --filter sightline-web preview",
    "dev": "concurrently \"pnpm run web:dev\" \"pnpm run api:dev\" --names web,api -c blue,green",
    "install:all": "pnpm install && pnpm run api:install",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:seed": "docker compose exec api python manage.py seed_sightline"
  },
  "devDependencies": {
    "concurrently": "^8.0.0",
    "cross-env": "^10.1.0"
  }
}
